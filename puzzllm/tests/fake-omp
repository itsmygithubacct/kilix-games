#!/usr/bin/env python3
"""Stand-in for omp in the sandbox tests.

Started by puzzllm-agent-init exactly as omp would be. It reads the provider
the sandbox wrote into the agent state folder, asks that model for the
file's text, and writes hello_world.txt in its working directory: the level-1
goal reached through the same chain the real agent uses.
"""
import json
import os
import re
import sys
import urllib.request

home = os.environ["HOME"]
assert home == "/opt/puzzllm/home" and os.path.islink(home) and os.readlink(home) == "/kilix"
assert os.getcwd() == "/kilix" and "--allow-home" in sys.argv
if os.environ.get("PUZZLLM_YOLO") == "1":
    assert "--approval-mode=yolo" in sys.argv
    print("fake-omp: yolo")
else:
    assert "--approval-mode=yolo" not in sys.argv
models = open(os.path.join(os.environ["PI_CODING_AGENT_DIR"], "models.yml")).read()
base = re.search(r"baseUrl:\s*(\S+)", models).group(1)
model = re.search(r"- id:\s*(\S+)", models).group(1)
request = urllib.request.Request(
    base + "/chat/completions",
    data=json.dumps({"model": model, "messages": [
        {"role": "user", "content": "Create hello_world.txt"}]}).encode(),
    headers={"Content-Type": "application/json"})
with urllib.request.urlopen(request, timeout=10) as response:
    text = json.load(response)["choices"][0]["message"]["content"]
with open("hello_world.txt", "w") as out:
    out.write(text + "\n")
print("fake-omp: wrote hello_world.txt")

