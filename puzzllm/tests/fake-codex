#!/bin/bash
set -eu
[[ $PWD = /kilix && $CODEX_HOME = /opt/puzzllm/codex-home && $HOME = /kilix ]]
if [[ " $* " = *" login status "* ]]; then
    test -f "$CODEX_HOME/mock-signed-in"
    exit
fi
if [[ " $* " = *" login --device-auth "* ]]; then
    touch "$CODEX_HOME/mock-signed-in"
    exit
fi
[[ " $* " = *" --no-daemon "* && " $* " = *" --ask-for-approval never "* ]]
[[ " $* " = *'permissions.puzzllm.network.enabled=false'* ]]
[[ " $* " = *'"/opt/puzzllm/codex-home"="deny"'* ]]
[[ " $* " = *'"/kilix"="write"'* ]]
printf 'Hello, World!\n' > hello_world.txt
printf 'fake-codex: wrote the workspace file\n'
