#!/bin/bash
set -eu

[[ $1 = --model && $2 = puzzllm-local/test/agent:7b ]]
# A request to the private guest loopback follows the same route omp uses.
python3 - <<'PY'
import http.client
import json
import os


def call(path, model, content=None):
    if content is None:
        content = [{"type": "text", "text": "Hello"}]
    request = http.client.HTTPConnection("127.0.0.1", int(os.environ["PUZZLLM_PORT"]), timeout=5)
    try:
        request.request("POST", path, json.dumps({"model": model, "messages": [
            {"role": "user", "content": content}], "stream": True}))
        with request.getresponse() as response:
            return response.status, response.read()
    finally:
        request.close()


assert call("/api/pull", "test/agent:7b")[0] == 404
assert call("/v1/chat/completions", "test/other:latest")[0] == 400
assert call("/v1/chat/completions", "test/agent:7b", [
    {"type": "image_url", "image_url": {"url": "https://example.invalid/image"}}
])[0] == 400
status, body = call("/v1/chat/completions", "test/agent:7b")
assert status == 200 and b"Hello from the selected model" in body and b"[DONE]" in body
print("fake-ollama-omp: completion received")
PY
