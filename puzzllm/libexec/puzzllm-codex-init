#!/bin/bash
# Runs only inside the Codex container.
set -eu

codex=$1
shift
auth=(-c 'cli_auth_credentials_store="file"')
policy=(-c 'default_permissions="puzzllm"'
        -c 'permissions.puzzllm.filesystem={":minimal"="read","/kilix"="write","/opt/puzzllm/home"="write","/opt/puzzllm/tmux"="read","/opt/puzzllm/bin"="read","/opt/puzzllm/cli"="read","/opt/puzzllm/kx/g"="write","/opt/puzzllm/kx/goals"="read","/opt/puzzllm/kx/controls"="read","/opt/puzzllm/codex-home"="deny"}'
        -c 'permissions.puzzllm.network.enabled=false'
        -c 'projects."/kilix".trust_level="untrusted"'
        # Command tools run in a separate PID namespace with networking disabled.
        -c 'shell_environment_policy.set.PUZZLLM_FILE_CONTROLS="1"'
        -c 'shell_environment_policy.set.KITTY_PTY_BROKER_SESSION=""'
        -c 'shell_environment_policy.set.HOME="/kilix"'
        -c 'shell_environment_policy.set.PATH="/opt/puzzllm/bin:/usr/local/bin:/usr/bin:/bin"'
        -c 'web_search="disabled"'
        --disable hooks --disable plugins)

if [ "${1:-}" = --check-sandbox ]; then
    shift
    exec "$codex" sandbox "${policy[@]}" -- "$@"
fi
if ! "$codex" "${auth[@]}" login status >/dev/null 2>&1; then
    printf 'Sign in to Codex for PuzzLLM.\n'
    "$codex" "${auth[@]}" login --device-auth
fi
choice=()
if [ -n "${PUZZLLM_HOSTED_MODEL:-}" ]; then choice+=(--model "$PUZZLLM_HOSTED_MODEL"); fi
if [ -n "${PUZZLLM_HOSTED_EFFORT:-}" ]; then choice+=(-c "model_reasoning_effort=\"$PUZZLLM_HOSTED_EFFORT\""); fi
set -- "${choice[@]}" "$@"
if [ "${PUZZLLM_YOLO:-0}" = 1 ]; then
    exec "$codex" "${auth[@]}" --yolo --no-daemon --no-alt-screen "$@"
fi
exec "$codex" "${auth[@]}" "${policy[@]}" --no-daemon --no-alt-screen \
    --ask-for-approval never "$@"
