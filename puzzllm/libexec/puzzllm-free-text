#!/usr/bin/env python3
"""Run and score generated responses with EleutherAI's task definitions."""

from contextlib import ExitStack
import json
import os
import re
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile

HARNESS = ("lm_eval[ifeval] @ https://github.com/EleutherAI/lm-evaluation-harness/archive/"
           "d6de81643928d653435c431bae19945d41d32520.tar.gz")
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "third_party/kilix-bench/src"))
from kilix_bench.yesno.worker import llama_server
from kilix_bench.yesno.models import stop_child


def status(message):
    print(message, flush=True)


def interrupted(signum, frame):
    raise SystemExit(128 + signum)


def run(task, state, model):
    metric = {"ifeval": "prompt_level_strict_acc,none", "gsm8k": "exact_match,strict-match"}[task]
    if runner := shutil.which("lm-eval"):
        launcher = [runner]
    elif uv := shutil.which("uv"):
        launcher = [uv, "tool", "run", "--from", HARNESS, "lm-eval"]
    else:
        raise ValueError("Install uv or lm-eval with the ifeval extra.")

    limit = os.environ.get("PUZZLLM_FREE_TEXT_LIMIT")
    if limit and int(limit) < 1:
        raise ValueError("PUZZLLM_FREE_TEXT_LIMIT must be positive.")
    base = Path(state) / "bench" / "free-text" / task
    base.mkdir(parents=True, exist_ok=True)
    dest = Path(tempfile.mkdtemp(prefix="run-", dir=base))
    with ExitStack() as stack:
        endpoint = os.environ.get("PUZZLLM_FREE_TEXT_ENDPOINT")
        if not endpoint:
            os.environ.setdefault("PUZZLLM_ROOT", str(ROOT))
            if not model:
                settings = subprocess.check_output([ROOT / "libexec/puzzllm-sandbox", "paths"], text=True)
                model = dict(line.split("=", 1) for line in settings.splitlines() if "=" in line).get("model")
            if not model:
                raise ValueError("Select a GGUF model or set PUZZLLM_FREE_TEXT_ENDPOINT.")
            scratch = Path(stack.enter_context(tempfile.TemporaryDirectory()))
            endpoint, _ = stack.enter_context(llama_server(model, scratch, status))
            subject = Path(model).name
        else:
            subject = endpoint
        (dest / "run.json").write_text(json.dumps({"task": task, "model": subject, "limit": limit}) + "\n")
        command = [*launcher, "run", "--model", "gguf", "--model_args", "base_url=" + endpoint,
                   "--tasks", task, "--output_path", str(dest), "--log_samples"]
        if limit:
            command.extend(["--limit", limit])
        status(f"Running {task} on {subject}")
        with (dest / "worker.log").open("w") as log:
            proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                    text=True, errors="replace", start_new_session=True)
            stack.callback(stop_child, proc)
            generating = False
            with proc.stdout:
                for line in proc.stdout:
                    log.write(line)
                    log.flush()
                    if "Running generate_until requests" in line:
                        generating = True
                    if generating and (progress := re.search(r"\|\s*(\d+)/(\d+)\s*\[", line)):
                        status(f"{task}: {progress[1]}/{progress[2]} responses")
            if proc.wait():
                raise RuntimeError(f"See bench/free-text/{task}/{dest.name}/worker.log")
        report, = dest.rglob("results_*.json")
        data = json.loads(report.read_text())
        score = data["results"][task][metric]
        n = data["n-samples"][task]["effective"]
        status(f"{task} score {100 * score:.1f}% ({n} {'item' if n == 1 else 'items'})")


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGHUP, interrupted)
    try:
        run(*sys.argv[1:])
    except (OSError, ValueError, RuntimeError, KeyError, subprocess.SubprocessError) as exc:
        status(f"Failed: {exc}")
        sys.exit(1)
