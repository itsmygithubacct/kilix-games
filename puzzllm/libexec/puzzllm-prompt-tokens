#!/bin/bash
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
paths=$("$here/puzzllm-sandbox" paths)
model=$(sed -n 's/^model=//p' <<< "$paths")
server=$(sed -n 's/^llama_server=//p' <<< "$paths")
tokenizer=${PUZZLLM_TOKENIZER:-}
if [ -z "$tokenizer" ] && [ -n "$server" ]; then
    tokenizer=$(dirname "$(readlink -f "$server")")/llama-tokenize
fi
if [ ! -x "$tokenizer" ] && [ -z "${PUZZLLM_TOKENIZER:-}" ]; then
    tokenizer=$(command -v llama-tokenize || true)
fi
[ -x "$tokenizer" ] && [ -r "$model" ] || exit 2
printf '%s' "${PUZZLLM_PROMPT_TEXT:-}" |
    "$tokenizer" -m "$model" --stdin --no-bos --show-count 2>/dev/null |
    sed -n 's/^Total number of tokens: \([0-9][0-9]*\)$/\1/p'
