#!/bin/bash
# puzzllm-fetch - download one model on the host. Do not run this in the sandbox.
#
#   puzzllm-fetch gguf ID
#   puzzllm-fetch diffusion ID
#   puzzllm-fetch ollama NAME
#
# llama.cpp files land in the models directory find_model already uses.
# Text diffusion GGUFs land in the folder the Bench and kilix-chat search.
# Ollama models are pulled by name. A GGUF is never imported into Ollama.
set -euo pipefail
umask 077

die() {
    printf '%s\n' "$1"
    exit 2
}

models_dir() {
    printf '%s\n' "${KILIX_LLM_MODELS_DIR:-${GPU_TERMINAL_HOME:-$HOME/.local/gpu_terminal}/kilix-llm/models}"
}

diffusion_dir() {
    printf '%s\n' "${PUZZLLM_DIFFUSION_MODELS:-${XDG_DATA_HOME:-$HOME/.local/share}/puzzllm/diffusion}"
}

plain_gguf() {
    case "$1" in
        [A-Za-z0-9][A-Za-z0-9._-]*.gguf) ;;
        *) return 1 ;;
    esac
    case "$1" in
        *..*|*/*) return 1 ;;
    esac
}

ollama_name_ok() {
    case "$1" in
        ''|*..*|*//*|[/:.]*|*[/:]|-*|*[!A-Za-z0-9_.:/-]*) return 1 ;;
    esac
    [ "${#1}" -le 128 ]
}

fixture_spec() {
    id=$1
    if [ "$id" = fixture ] && [ "${PUZZLLM_FETCH_FIXTURE_ID:-}" = fixture ]; then
        file=${PUZZLLM_FETCH_FIXTURE_FILE:-}
        bytes=${PUZZLLM_FETCH_FIXTURE_BYTES:-}
        sha=${PUZZLLM_FETCH_FIXTURE_SHA:-}
        url=${PUZZLLM_FETCH_FIXTURE_URL:-}
        plain_gguf "$file" || die "fixture file must be a plain GGUF name"
        case "$bytes" in
            ''|*[!0-9]*) die "fixture size must be a byte count" ;;
        esac
        case "$sha" in
            *[!0-9a-f]*|'') die "fixture sha256 is not 64 hex digits" ;;
        esac
        [ "${#sha}" -eq 64 ] || die "fixture sha256 is not 64 hex digits"
        case "$url" in
            https://*|file://*) ;;
            *) die "fixture url must be https or file" ;;
        esac
        return 0
    fi
    return 1
}

diffusion_spec() {
    fixture_spec "$1" && return 0
    case "$1" in
        llada-moe-7b-a1b)
            file=LLaDA-MoE-7B-A1B-Instruct.Q4_K_M.gguf
            bytes=4520661184
            sha=a8fc1d9d43718a742b55b122cdca739a9cc2e790e38b2316b1a5b10e84489b27
            url=https://huggingface.co/mradermacher/LLaDA-MoE-7B-A1B-Instruct-GGUF/resolve/1080e16761f6f82a92e8bfb54a4c8998dfee0219/LLaDA-MoE-7B-A1B-Instruct.Q4_K_M.gguf
            ;;
        llada-1.5)
            file=LLaDA-1.5.Q4_K_M.gguf
            bytes=4925226240
            sha=967765045ef1f9db6f4dff72b14a338e0c897e81618f7779105426e9e2e9fce8
            url=https://huggingface.co/mradermacher/LLaDA-1.5-GGUF/resolve/5acdac19a98ed7ff799324391d82c602474edf3b/LLaDA-1.5.Q4_K_M.gguf
            ;;
        dream-coder-7b)
            file=Dream-Coder-v0-Instruct-7B.Q4_K_M.gguf
            bytes=4683074016
            sha=c1b2c58e9f2a6e9cd548347e5845c3e5306862be1151329b22c5b3956d858e3c
            url=https://huggingface.co/mradermacher/Dream-Coder-v0-Instruct-7B-GGUF/resolve/e22431dd659aba45146840ac9b6b9417aff3cac5/Dream-Coder-v0-Instruct-7B.Q4_K_M.gguf
            ;;
        d3llm-llada)
            file=d3LLM_LLaDA.Q4_K_M.gguf
            bytes=4925226656
            sha=eb450d47abe05c1c1503d78751a8453c8834ef1a8d34802173914379b7cafa88
            url=https://huggingface.co/mradermacher/d3LLM_LLaDA-GGUF/resolve/6cbf038bb867cd42bb4ff9b9ce931af23b32e3df/d3LLM_LLaDA.Q4_K_M.gguf
            ;;
        *) die "unknown diffusion model" ;;
    esac
}

gguf_spec() {
    fixture_spec "$1" && return 0
    case "$1" in
        qwen3.5-0.8b)
            file=Qwen3.5-0.8B-Q8_0.gguf
            bytes=833592096
            sha=37ae482d336108d23516fa35e8e0c4126688d81018b87178a18d752a1357814f
            url=https://huggingface.co/ggml-org/Qwen3.5-0.8B-GGUF/resolve/807dfd9a6fadbf703207aac3bfb0b2b3040d077c/Qwen3.5-0.8B-Q8_0.gguf
            ;;
        qwen3.5-4b-q4)
            file=Qwen3.5-4B-Q4_K_M.gguf
            bytes=2740937888
            sha=00fe7986ff5f6b463e62455821146049db6f9313603938a70800d1fb69ef11a4
            url=https://huggingface.co/unsloth/Qwen3.5-4B-GGUF/resolve/e87f176479d0855a907a41277aca2f8ee7a09523/Qwen3.5-4B-Q4_K_M.gguf
            ;;
        gemma4-e2b-q4-k-m)
            file=gemma-4-E2B-it-Q4_K_M.gguf
            bytes=3106738272
            sha=740185b21d22ceb83a11c3aa62ad5842ef32c70f6096d756bbee85a1e4ec34b8
            url=https://huggingface.co/unsloth/gemma-4-E2B-it-GGUF/resolve/0314792d7f1f7e229411f620751375812bb9faf2/gemma-4-E2B-it-Q4_K_M.gguf
            ;;
        *) die "unknown llama.cpp model" ;;
    esac
}

fetch_gguf() {
    local id=$1 spec=$2 dir=$3 dest size sum tmp
    "$spec" "$id"
    mkdir -p -- "$dir"
    dest=$dir/$file
    exec 9>"$dir/.fetch.lock"
    flock -w 1 9 || die "another download is using the models folder"
    if [ -L "$dest" ]; then die "refusing to replace a symlink"; fi
    if [ -f "$dest" ]; then
        size=$(stat -c %s -- "$dest")
        sum=$(sha256sum -- "$dest" | awk '{print $1}')
        if [ "$size" = "$bytes" ] && [ "$sum" = "$sha" ]; then
            printf 'already saved %s\n' "$file"
            exit 0
        fi
        die "$file is already in the models folder and does not match"
    fi
    tmp=$(mktemp "$dir/.partial.XXXXXX")
    trap 'rm -f -- "$tmp"' EXIT
    trap 'exit 143' HUP INT TERM
    if ! curl -fL --retry 2 --connect-timeout 15 -o "$tmp" "$url" >/dev/null 2>&1; then
        printf 'could not download %s\n' "$file"
        exit 1
    fi
    size=$(stat -c %s -- "$tmp")
    sum=$(sha256sum -- "$tmp" | awk '{print $1}')
    if [ "$size" != "$bytes" ] || [ "$sum" != "$sha" ]; then
        printf 'downloaded %s did not match\n' "$file"
        exit 1
    fi
    mv -T -- "$tmp" "$dest"
    trap - EXIT
    printf 'saved %s\n' "$file"
}

fetch_ollama() {
    local name=$1
    ollama_name_ok "$name" || die "Ollama names use letters, digits, and . _ : / -"
    command -v ollama >/dev/null 2>&1 || die "ollama is not installed"
    if ollama show "$name" >/dev/null 2>&1; then
        printf 'already installed %s\n' "$name"
        exit 0
    fi
    if ! ollama pull "$name" >/dev/null 2>&1; then
        printf 'could not pull %s\n' "$name"
        exit 1
    fi
    printf 'pulled %s\n' "$name"
}

mode=${1:-}
arg=${2:-}
case "$mode" in
    gguf) [ -n "$arg" ] || die "usage: puzzllm-fetch gguf ID"; fetch_gguf "$arg" gguf_spec "$(models_dir)" ;;
    diffusion) [ -n "$arg" ] || die "usage: puzzllm-fetch diffusion ID"
               fetch_gguf "$arg" diffusion_spec "$(diffusion_dir)" ;;
    ollama) fetch_ollama "$arg" ;;
    *) die "usage: puzzllm-fetch gguf ID | puzzllm-fetch diffusion ID | puzzllm-fetch ollama NAME" ;;
esac
