#!/bin/bash
# puzzllm-agent-init - first process inside the agent sandbox.
#
# Starts llama-server on the sandbox's private loopback, waits until it
# answers, then replaces itself with omp. bwrap is PID 1 of the sandbox, so
# llama-server dies with the sandbox when omp exits.
#
# Progress goes to the terminal (the omp screen) and to
# $PI_CODING_AGENT_DIR/puzzllm/status, which the game shows on the activity screen.
set -u
port=${PUZZLLM_PORT:-8765}
model_id=${PUZZLLM_MODEL_ID:-qwen3.5-0.8b}
status_dir=$PI_CODING_AGENT_DIR/puzzllm
status=$status_dir/status
log=$status_dir/llama-server.log
mkdir -p "$status_dir"

say() {
    printf '%s\n' "$*" > "$status.tmp" && mv -f "$status.tmp" "$status"
    printf '\033[2m[puzzllm] %s\033[0m\r\n' "$*"
}

health() {
    local reply
    { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null || return 1
    printf 'GET /health HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n' >&3
    IFS= read -r -t 2 reply <&3
    exec 3>&-
    case "$reply" in *" 200"*) return 0 ;; esac
    return 1
}

start_pi() {
    local thinking=off
    [ "${PUZZLLM_THINK:-0}" = 1 ] && thinking=medium
    exec "$PUZZLLM_PI_COMMAND" --provider puzzllm-local --model "$model_id" \
        --models "puzzllm-local/$model_id" --thinking "$thinking" \
        --session-dir "$PI_CODING_AGENT_DIR/sessions" \
        --offline --no-approve --no-extensions --no-skills --no-prompt-templates \
        --no-context-files --no-themes \
        --append-system-prompt "Inspect the player shell as described in ~/docs/tmux.md." "$@"
}

compute=${PUZZLLM_COMPUTE:-auto}
if [ -n "${PUZZLLM_OLLAMA_MODEL:-}" ]; then
    tool_prompt=$(cat /opt/puzzllm/ollama-prompt.txt) || exit 2
    /opt/puzzllm/bin/puzzllm-ollama guest "$port" &
    relay=$!
    # Opening the loopback socket tells us the relay is listening.
    for _ in $(seq 1 40); do
        if { exec 3<>"/dev/tcp/127.0.0.1/$port"; } 2>/dev/null; then
            exec 3>&-
            say "using Ollama model $model_id (compute: $compute, requested ${PUZZLLM_CTX:-32768} context tokens)"
            if [ -n "${PUZZLLM_PI_COMMAND:-}" ]; then
                tool_prompt=${tool_prompt/and i (a short description)/and no other arguments}
                start_pi --system-prompt "$tool_prompt" "$@"
            fi
            exec /opt/puzzllm/bin/omp --model "puzzllm-local/$model_id" \
                --system-prompt "$tool_prompt" \
                --allow-home --no-title --no-lsp --no-extensions --no-skills --no-rules "$@"
        fi
        kill -0 "$relay" 2>/dev/null || break
        sleep 0.1
    done
    say "Ollama relay did not come up"
    exit 2
fi

think_args=(--reasoning-budget 0)
[ "${PUZZLLM_THINK:-0}" = 1 ] && think_args=()
device_args=(--device none --gpu-layers 0)
placement=CPU
if [ "$compute" = gpu ] || [ -n "${PUZZLLM_GPU:-}" ]; then
    if ! /opt/puzzllm/llama/llama-server --list-devices >"$log" 2>&1 ||
       ! grep -Eq '^  [^[:space:]:]+: ' "$log"; then
        say "llama.cpp found no GPU inside the sandbox. Select CPU or check the GPU backend."
        exit 2
    fi
    device_args=(--gpu-layers 99)
    [ -n "${PUZZLLM_GPU:-}" ] && device_args+=(--device "$PUZZLLM_GPU")
    placement=GPU
fi

say "starting Qwen 3.5 ($model_id) on $placement"
/opt/puzzllm/llama/llama-server \
    --model /opt/puzzllm/model.gguf --alias "$model_id" \
    --host 127.0.0.1 --port "$port" --ctx-size "${PUZZLLM_CTX:-32768}" \
    --jinja "${think_args[@]}" "${device_args[@]}" --no-webui \
    >"$log" 2>&1 &
server=$!

for _ in $(seq 1 600); do
    if health; then break; fi
    if ! kill -0 "$server" 2>/dev/null; then
        say "llama-server exited; see agent/puzzllm/llama-server.log"
        tail -n 15 "$log"
        exec bash -i
    fi
    sleep 0.2
done
health || { say "llama-server did not come up"; exec bash -i; }

if [ -n "${PUZZLLM_PI_COMMAND:-}" ]; then
    say "Qwen 3.5 ready; starting Pi"
    start_pi "$@"
fi
say "Qwen 3.5 ready; starting omp"
exec /opt/puzzllm/bin/omp --model "puzzllm-local/$model_id" \
    --append-system-prompt "Inspect the player's shell with tmux capture-pane -p -t shell. Its output is recorded in ~/shell.log." \
    --allow-home --no-title --no-lsp --no-extensions --no-skills --no-rules "$@"
