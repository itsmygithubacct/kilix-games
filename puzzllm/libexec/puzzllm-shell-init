#!/bin/bash
# The tmux server runs inside the player shell sandbox.
set -eu
command -v tmux >/dev/null || { printf 'PuzzLLM requires tmux for the shell pane.\n' >&2; exit 2; }
log=$HOME/shell.log
if [[ -L "$log" || ( -e "$log" && ! -f "$log" ) ]]; then
    printf '~/shell.log must be a regular file.\n' >&2
    exit 2
fi
umask 077
export SHELL=/bin/bash
touch -- "$log"

# Keep the tmux server below the shell pane's broker. A daemonized server
# loses that ancestry, so Kilix cannot verify commands from its player shell.
if tmux -N has-session -t '=shell' 2>/dev/null; then
    exec tmux -N attach-session -t '=shell'
fi
setsid tmux -D -f /dev/null </dev/null >/dev/null 2>&1 &
server=$!
for ((i = 0; i < 100; i++)); do
    tmux -N show-options -s >/dev/null 2>&1 && break
    kill -0 "$server" 2>/dev/null || { wait "$server"; exit 1; }
    sleep 0.02
done
if ! tmux -N show-options -s >/dev/null 2>&1; then
    kill "$server" 2>/dev/null || true
    wait "$server" 2>/dev/null || true
    printf 'PuzzLLM could not start the player shell.\n' >&2
    exit 1
fi
# Wait to start Bash until its output pipe is hooked up, including the prompt.
exec tmux -N new-session -d -s shell -n shell -c "$HOME" \
    'tmux wait-for puzzllm-shell-log && exec /bin/bash --rcfile /opt/puzzllm/shellrc -i' \
    \; set-option -s exit-empty on \
    \; set-option -g status off \
    \; set-option -g mouse on \
    \; select-pane -t shell:shell.0 -T shell \
    \; pipe-pane -O -t shell:shell.0 'exec /opt/puzzllm/bin/puzzllm-shell-log "$HOME/shell.log"' \
    \; wait-for -S puzzllm-shell-log \
    \; attach-session -t shell
