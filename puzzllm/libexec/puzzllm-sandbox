#!/bin/bash
# puzzllm-sandbox - run the coding agent or the player's shell confined.
#
#   puzzllm-sandbox agent [OMP-ARGS...]     llama-server + omp, interactive
#   puzzllm-sandbox codex                   Codex CLI with separate sign-in
#   puzzllm-sandbox shell                   the player's bash
#   puzzllm-sandbox agent-exec -- CMD...    CMD with exactly the agent's mounts
#   puzzllm-sandbox shell-exec -- CMD...    CMD with exactly the shell's mounts
#   puzzllm-sandbox count-setup|count-check  install or check the Bash puzzle
#   puzzllm-sandbox paths                   print the resolved paths and exit
#
# The omp and shell sandboxes are bubblewrap containers with every namespace unshared
# (network included: the only reachable host is the sandbox's own loopback),
# a read-only /usr and a short read-only list from /etc, and a tmpfs home and
# /tmp. Nothing of the host's home directory is visible.
#
# What is writable, and nothing else on the host is:
#   agent  $STATE/workspace  at /kilix  (its home and working directory)
#          $STATE/agent      at /opt/puzzllm/agent (omp's config, sessions)
#   shell  $STATE/workspace  at /kilix  (its home and working directory)
#          The owner decided (2026-11-18) that the player may meet a goal by
#          hand in this shell, and that it counts the same as the LLM doing it.
#
# Environment (all optional):
#   PUZZLLM_STATE         persistent folder, default ~/.local/share/puzzllm
#   PUZZLLM_CODEX          Codex CLI executable (default: codex on PATH)
#   PUZZLLM_OMP           omp binary (default: omp on PATH, then ~/.local/bin/omp)
#   PUZZLLM_LLAMA_SERVER  llama-server binary; its directory is mounted for libs
#   PUZZLLM_MODEL         GGUF weights (default: the Qwen3.5 0.8B Zell uses)
#   PUZZLLM_MODEL_ID      model id shown to omp, default qwen3.5-0.8b
#   PUZZLLM_CTX           context tokens, default 32768
#   PUZZLLM_THINK=1       let the model think (off by default: 0.8B loops)
#   PUZZLLM_COMPUTE       auto, cpu, or gpu
#   PUZZLLM_GPU=DEVICE    run the model on a llama.cpp device such as Vulkan1
#                         (GPU device nodes are then mounted); default CPU
set -u

here=$(dirname "$(readlink -f "$0")")
state=${PUZZLLM_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/puzzllm}
model_id=${PUZZLLM_MODEL_ID:-qwen3.5-0.8b}
ctx=${PUZZLLM_CTX:-32768}
reasoning=false
[ "${PUZZLLM_THINK:-0}" = 1 ] && reasoning=true
port=8765
box_home=/kilix

die() { printf 'puzzllm-sandbox: %s\n' "$*" >&2; exit 2; }

ollama=${PUZZLLM_OLLAMA_MODEL:-}
if [ -n "$ollama" ]; then
    [[ $ollama =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.:/-]{0,254}$ ]] || die "invalid Ollama model name"
    model_id=$ollama
fi

command -v bwrap >/dev/null 2>&1 || die "bubblewrap (bwrap) is not installed"

find_omp() {
    if [ -n "${PUZZLLM_OMP:-}" ]; then printf '%s\n' "$PUZZLLM_OMP"; return; fi
    command -v omp 2>/dev/null && return
    [ -x "$HOME/.local/bin/omp" ] && printf '%s\n' "$HOME/.local/bin/omp"
}

find_llama() {
    local c
    if [ -n "${PUZZLLM_LLAMA_SERVER:-}" ]; then
        printf '%s\n' "$PUZZLLM_LLAMA_SERVER"; return
    fi
    command -v llama-server 2>/dev/null && return
    for c in "$HOME"/.local/share/kilix-llm/bench/engine/*/llama-b*/llama-server; do
        [ -x "$c" ] && { printf '%s\n' "$c"; return; }
    done
}

find_model() {
    local dir
    if [ -n "${PUZZLLM_MODEL:-}" ]; then printf '%s\n' "$PUZZLLM_MODEL"; return; fi
    dir=${KILIX_LLM_MODELS_DIR:-${GPU_TERMINAL_HOME:-$HOME/.local/gpu_terminal}/kilix-llm/models}
    [ -f "$dir/Qwen3.5-0.8B-Q8_0.gguf" ] && printf '%s\n' "$dir/Qwen3.5-0.8B-Q8_0.gguf"
}

omp_bin=$(find_omp)
llama_bin=$(find_llama)
model=$(find_model)

mode=${1:-}
[ $# -gt 0 ] && shift

if [ "$mode" = paths ]; then
    printf 'state=%s\nomp=%s\nllama_server=%s\nmodel=%s\nmodel_id=%s\n' \
        "$state" "${omp_bin:-}" "${llama_bin:-}" "${model:-}" "$model_id"
    exit 0
fi

mkdir -p "$state/workspace" "$state/agent/puzzllm" || die "cannot create $state"

# Common confinement. Arrays keep every path one argument.
args=(
    --unshare-all --die-with-parent
    --hostname puzzllm
    --ro-bind /usr /usr
    --proc /proc --dev /dev
    --tmpfs /tmp --tmpfs /home
    --clearenv
    --setenv HOME "$box_home" --setenv USER kilix --setenv LOGNAME kilix
    --setenv PATH /opt/puzzllm/bin:/usr/local/bin:/usr/bin:/bin
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv LANG C.UTF-8 --setenv COLORTERM truecolor
    --setenv TMPDIR /tmp
)
for d in bin lib lib32 lib64 libx32 sbin; do
    if [ -L "/$d" ]; then
        args+=(--symlink "$(readlink "/$d")" "/$d")
    elif [ -d "/$d" ]; then
        args+=(--ro-bind "/$d" "/$d")
    fi
done
for f in passwd group nsswitch.conf ld.so.cache ld.so.conf ld.so.conf.d \
         localtime alternatives ssl ca-certificates terminfo inputrc \
         hosts host.conf manpath.config man_db.conf; do
    [ -e "/etc/$f" ] && args+=(--ro-bind "/etc/$f" "/etc/$f")
done

compute=${PUZZLLM_COMPUTE:-auto}
case "$compute" in auto|cpu|gpu) ;; *) die "PUZZLLM_COMPUTE must be auto, cpu, or gpu" ;; esac
gpu=${PUZZLLM_GPU:-}
if [ "$compute" = cpu ]; then gpu=; fi

case "$mode" in
count-setup)
    exec bwrap "${args[@]}" --new-session \
        --bind "$state/workspace" "$box_home" \
        --ro-bind "$here/../levels/count-files" /opt/puzzllm/fixture \
        --chdir "$box_home" --remount-ro / -- cp -an /opt/puzzllm/fixture/. .
    ;;
count-check)
    cases=(--dir "/empty folder" --dir "/other files/subfolder")
    # Vary the second populated case to keep a hard-coded total from passing.
    extra=$((4 + RANDOM % 4))
    for ((i = 0; i < extra; i++)); do
        cases+=(--ro-bind /usr/bin/true "/other files/item $i")
    done
    cases+=(--ro-bind /usr/bin/true "/other files/subfolder/ignored.txt")
    exec timeout --kill-after=1s 3s bwrap "${args[@]}" "${cases[@]}" --new-session \
        --ro-bind "$state/workspace" "$box_home" \
        --ro-bind "$here/puzzllm-count-check" /opt/puzzllm/count-check \
        --chdir "$box_home" --remount-ro / -- bash /opt/puzzllm/count-check
    ;;
esac

# Only the shell server needs to create the socket. Agents connect to
# the same pathname from their separate namespaces.
case "$mode" in
agent|agent-exec|shell|shell-exec)
    (umask 077 && mkdir -p "$state/tmux") || die "cannot create tmux state"
    tmux_mount=--ro-bind
    [ "$mode" = shell ] && tmux_mount=--bind
    args+=("$tmux_mount" "$state/tmux" /opt/puzzllm/tmux
           --setenv TMUX_TMPDIR /opt/puzzllm/tmux)
    ;;
esac

case "$mode" in
agent|agent-exec)
    args+=(--bind "$state/workspace" "$box_home"
           --bind "$state/agent" /opt/puzzllm/agent
           --setenv PI_CODING_AGENT_DIR /opt/puzzllm/agent
           --chdir "$box_home")
    [ -n "$omp_bin" ] && [ -x "$omp_bin" ] &&
        args+=(--ro-bind "$(readlink -f "$omp_bin")" /opt/puzzllm/bin/omp)
    [ -z "$ollama" ] && [ -n "$llama_bin" ] && [ -x "$llama_bin" ] &&
        args+=(--ro-bind "$(dirname "$(readlink -f "$llama_bin")")" /opt/puzzllm/llama)
    [ -z "$ollama" ] && [ -n "$model" ] && [ -f "$model" ] &&
        args+=(--ro-bind "$(readlink -f "$model")" /opt/puzzllm/model.gguf)
    args+=(--ro-bind "$here/puzzllm-agent-init" /opt/puzzllm/bin/puzzllm-agent-init
           --setenv PUZZLLM_PORT "$port"
           --setenv PUZZLLM_MODEL_ID "$model_id"
           --setenv PUZZLLM_CTX "$ctx"
           --setenv PUZZLLM_THINK "${PUZZLLM_THINK:-0}"
           --setenv PUZZLLM_COMPUTE "$compute"
           --setenv PUZZLLM_GPU "$gpu")
    if [ -z "$ollama" ] && { [ "$compute" = gpu ] || [ -n "$gpu" ]; }; then
        for n in /dev/dri /dev/kfd /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-modeset \
                 /dev/nvidia[0-9]*; do
            [ -e "$n" ] && args+=(--dev-bind "$n" "$n")
        done
        for n in /sys /etc/vulkan /etc/glvnd; do
            [ -e "$n" ] && args+=(--ro-bind "$n" "$n")
        done
    fi
    ;;
codex)
    codex_bin=${PUZZLLM_CODEX:-$(command -v codex)}
    [ -n "$codex_bin" ] && [ -x "$codex_bin" ] ||
        die "Codex CLI not found (install codex or set PUZZLLM_CODEX)"
    codex_command=$(readlink -f "$codex_bin")
    case "$codex_command" in
        /usr/*) ;;  # Includes npm's wrapper and its dependencies.
        *)
            args+=(--ro-bind "$codex_command" /opt/puzzllm/bin/codex)
            codex_command=/opt/puzzllm/bin/codex
            ;;
    esac
    (umask 077 && mkdir -p "$state/codex") || die "cannot create Codex state"
    # The CLI connects to its hosted provider. Its separate command policy
    # denies network access and masks the Codex credentials from tools.
    args+=(--share-net
           --bind "$state/workspace" "$box_home"
           --bind "$state/codex" /opt/puzzllm/codex-home
           --chdir "$box_home"
           --setenv CODEX_HOME /opt/puzzllm/codex-home
           --ro-bind "$here/puzzllm-codex-init" /opt/puzzllm/bin/puzzllm-codex-init)
    [ ! -r /etc/resolv.conf ] || args+=(--ro-bind /etc/resolv.conf /etc/resolv.conf)
    ;;
shell|shell-exec)
    args+=(--bind "$state/workspace" "$box_home"
           --chdir "$box_home"
           --ro-bind "$here/puzzllm-shellrc" /opt/puzzllm/shellrc
           --ro-bind "$here/puzzllm-shell-init" /opt/puzzllm/bin/puzzllm-shell-init)
    ;;
*)
    die "usage: puzzllm-sandbox agent|codex|shell|agent-exec -- CMD|shell-exec -- CMD|paths"
    ;;
esac

case "$mode" in
agent)
    [ -n "$omp_bin" ] && [ -x "$omp_bin" ] ||
        die "omp not found (set PUZZLLM_OMP)"
    model_name="Qwen 3.5 (local)"
    if [ -n "$ollama" ]; then
        model_name="$ollama (Ollama)"
        args+=(--ro-bind @OLLAMA_SOCKET@ /opt/puzzllm/ollama.sock
               --ro-bind "$here/puzzllm-ollama" /opt/puzzllm/bin/puzzllm-ollama
               --ro-bind "$here/puzzllm-ollama-prompt.txt" /opt/puzzllm/ollama-prompt.txt
               --setenv PUZZLLM_OLLAMA_MODEL "$ollama")
    else
        [ -n "$llama_bin" ] && [ -x "$llama_bin" ] ||
            die "llama-server not found (set PUZZLLM_LLAMA_SERVER)"
        [ -n "$model" ] && [ -f "$model" ] ||
            die "Qwen 3.5 weights not found (set PUZZLLM_MODEL); nothing is downloaded"
    fi
    # omp's provider config lives in the sandbox's own agent folder, never
    # in the user's ~/.omp: one local provider, on the sandbox's loopback.
    cat > "$state/agent/models.yml" <<EOF
# Written by puzzllm-sandbox on every start. One provider on private loopback.
providers:
  puzzllm-local:
    baseUrl: http://127.0.0.1:$port/v1
    api: openai-completions
    apiKey: puzzllm-local
    models:
      - id: "$model_id"
        name: "$model_name"
        reasoning: $reasoning
        input: [text]
        contextWindow: $ctx
        maxTokens: 4096
EOF
    # A fresh omp profile opens a setup wizard that offers cloud sign-ins;
    # mark setup done (omp's own setupVersion key) so it starts at its prompt.
    cfg=$state/agent/config.yml
    if ! grep -q '^setupVersion:' "$cfg" 2>/dev/null; then
        printf 'setupVersion: 2\n' >> "$cfg"
    fi
    if [ -n "$ollama" ]; then
        exec "$here/puzzllm-ollama" host "$state" "$ollama" \
            bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-agent-init "$@"
    fi
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-agent-init "$@"
    ;;
codex)
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-codex-init "$codex_command" "$@"
    ;;
shell)
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-shell-init
    ;;
agent-exec|shell-exec)
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "$mode needs a command"
    exec bwrap "${args[@]}" --remount-ro / -- "$@"
    ;;
esac
