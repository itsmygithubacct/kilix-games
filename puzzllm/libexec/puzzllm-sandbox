#!/bin/bash
# puzzllm-sandbox - run the coding agent or the player's shell confined.
#
#   puzzllm-sandbox agent [OMP-ARGS...]     llama-server + omp, interactive
#   puzzllm-sandbox codex                   Codex CLI with separate sign-in
#   puzzllm-sandbox grok                    Grok Build CLI with separate sign-in
#   puzzllm-sandbox claude                  Claude Code with separate sign-in
#   puzzllm-sandbox shell                   the player's bash
#   puzzllm-sandbox agent-exec -- CMD...    CMD with exactly the agent's mounts
#   puzzllm-sandbox shell-exec -- CMD...    CMD with exactly the shell's mounts
#   puzzllm-sandbox count-setup|count-check  install or check the Bash puzzle
#   puzzllm-sandbox log-setup                install the shell-log puzzle
#   puzzllm-sandbox script-check NAME        grade one workspace Bash file
#   puzzllm-sandbox paths                   print the resolved paths and exit
#
# The omp and shell sandboxes are bubblewrap containers with every namespace unshared
# (network included: the only reachable host is the sandbox's own loopback),
# a read-only /usr and a short read-only list from /etc, and a tmpfs home and
# /tmp. Nothing of the host's home directory is visible.
#
# What is writable, and nothing else on the host is:
#   agent  $STATE/workspace  at /kilix  (its home and working directory)
#          $STATE/agent      at /opt/puzzllm/agent (omp's config, sessions)
#   shell  $STATE/workspace  at /kilix  (its home and working directory)
#          The owner decided (2026-11-18) that the player may meet a goal by
#          hand in this shell, and that it counts the same as the LLM doing it.
#
# Environment (all optional):
#   PUZZLLM_STATE         persistent folder, default ~/.local/share/puzzllm
#   PUZZLLM_CODEX          Codex CLI executable (default: codex on PATH)
#   PUZZLLM_GROK           Native Grok Build executable
#   PUZZLLM_CLAUDE         Claude Code executable (default: claude on PATH)
#   PUZZLLM_YOLO=1         skip harness approval prompts (off by default)
#   PUZZLLM_OMP           omp binary (default: omp on PATH, then ~/.local/bin/omp)
#   PUZZLLM_HARNESS       omp (default) or pi
#   PUZZLLM_PI            Pi entry point (default: pi on PATH or ~/.local/bin/pi)
#   PUZZLLM_PI_NODE       Node executable for Pi (optional)
#   PUZZLLM_LLAMA_SERVER  llama-server binary; its directory is mounted for libs
#   PUZZLLM_MODEL         GGUF weights (default: the Qwen3.5 0.8B Zell uses)
#   PUZZLLM_MODEL_ID      model id shown to omp, default qwen3.5-0.8b
#   PUZZLLM_CTX           context tokens, default 32768
#   PUZZLLM_THINK=1       let the model think (off by default: 0.8B loops)
#   PUZZLLM_COMPUTE       auto, cpu, or gpu
#   PUZZLLM_GPU=DEVICE    run the model on a llama.cpp device such as Vulkan1
#                         (GPU device nodes are then mounted); default CPU
set -u

here=$(dirname "$(readlink -f "$0")")
state=${PUZZLLM_STATE:-${XDG_DATA_HOME:-$HOME/.local/share}/puzzllm}
model_id=${PUZZLLM_MODEL_ID:-qwen3.5-0.8b}
ctx=${PUZZLLM_CTX:-32768}
reasoning=false
[ "${PUZZLLM_THINK:-0}" = 1 ] && reasoning=true
yolo=0
[ "${PUZZLLM_YOLO:-0}" = 1 ] && yolo=1
port=8765
box_home=/kilix
harness=${PUZZLLM_HARNESS:-omp}

die() { printf 'puzzllm-sandbox: %s\n' "$*" >&2; exit 2; }

ollama=${PUZZLLM_OLLAMA_MODEL:-}
if [ -n "$ollama" ]; then
    [[ $ollama =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.:/-]{0,254}$ ]] || die "invalid Ollama model name"
    model_id=$ollama
fi

command -v bwrap >/dev/null 2>&1 || die "bubblewrap (bwrap) is not installed"

find_omp() {
    if [ -n "${PUZZLLM_OMP:-}" ]; then printf '%s\n' "$PUZZLLM_OMP"; return; fi
    command -v omp 2>/dev/null && return
    [ -x "$HOME/.local/bin/omp" ] && printf '%s\n' "$HOME/.local/bin/omp"
}

run_pi_setup() {
    local install_pid result=0
    setsid "$@" </dev/null &
    install_pid=$!
    trap 'kill -TERM -- "-$install_pid" 2>/dev/null || kill -TERM "$install_pid" 2>/dev/null || true; exit 143' HUP INT TERM
    wait "$install_pid" || result=$?
    trap - HUP INT TERM
    return "$result"
}

mount_pi() {
    local entry managed version modules node fd
    local runtime=$state/runtime/pi
    entry=${PUZZLLM_PI:-$(command -v pi || true)}
    if [ -n "${PUZZLLM_PI:-}" ] && [ ! -x "$entry" ]; then
        die "PUZZLLM_PI does not point to an executable"
    fi
    if [ -z "$entry" ] && [ -x "$HOME/.local/bin/pi" ]; then
        entry=$HOME/.local/bin/pi
    fi
    if [ -z "$entry" ]; then
        entry=$runtime/node_modules/.bin/pi
        if [ ! -x "$entry" ]; then
            [ "$mode" = agent ] || return 0
            run_pi_setup "$here/puzzllm-install-pi" "$runtime" ||
                die "Pi installation failed. Press Enter in the agent pane to retry."
        fi
        if [ -x "$runtime/node/bin/node" ]; then
            node=$runtime/node/bin/node
        else
            node=$(command -v node || true)
        fi
    fi
    entry=$(readlink -f "$entry")
    # Resolve the official installer's launcher without mounting its profile.
    managed=$(dirname "$(dirname "$entry")")/install
    if [ -r "$managed/current-version" ]; then
        IFS= read -r version < "$managed/current-version"
        [[ $version =~ ^[a-zA-Z0-9][a-zA-Z0-9._+-]*$ ]] || die "invalid Pi installation version"
        entry=$(readlink -f "$managed/releases/$version/node_modules/.bin/pi")
        [ -x "$entry" ] || die "Pi installation is missing its entry point"
    fi
    case "$entry" in
        */node_modules/*)
            modules=${entry%%/node_modules/*}/node_modules
            args+=(--ro-bind "$modules" /opt/puzzllm/pi/node_modules)
            pi_command=/opt/puzzllm/pi/node_modules/${entry#"$modules/"}
            ;;
        *)
            pi_command=/opt/puzzllm/bin/pi
            args+=(--ro-bind "$entry" "$pi_command")
            ;;
    esac
    node=${PUZZLLM_PI_NODE:-${node:-${XDG_DATA_HOME:-$HOME/.local/share}/pi-node/current/bin/node}}
    if [ -z "${PUZZLLM_PI_NODE:-}" ] && [ ! -x "$node" ]; then
        node=$(command -v node || true)
    fi
    if [ -n "$node" ]; then
        [ -x "$node" ] || die "Pi's Node executable is missing"
        args+=(--ro-bind "$(readlink -f "$node")" /opt/puzzllm/bin/node)
    fi
    args+=(--setenv PUZZLLM_PI_COMMAND "$pi_command")
    fd=$(command -v fd || command -v fdfind || true)
    if [ -z "$fd" ]; then
        fd=$state/runtime/bin/fd
        if [ "$mode" = agent ] && [ ! -x "$fd" ]; then
            run_pi_setup "$here/puzzllm-install-fd" "$fd" ||
                printf '[puzzllm] Could not install fd. Pi can still use find.\n' >&2
        fi
    fi
    if [ -x "$fd" ]; then
        args+=(--ro-bind "$(readlink -f "$fd")" /opt/puzzllm/bin/fd)
    fi
}

find_llama() {
    local c
    if [ -n "${PUZZLLM_LLAMA_SERVER:-}" ]; then
        printf '%s\n' "$PUZZLLM_LLAMA_SERVER"; return
    fi
    command -v llama-server 2>/dev/null && return
    for c in "$HOME"/.local/share/kilix-llm/bench/engine/*/llama-b*/llama-server; do
        [ -x "$c" ] && { printf '%s\n' "$c"; return; }
    done
}

find_model() {
    local dir
    if [ -n "${PUZZLLM_MODEL:-}" ]; then printf '%s\n' "$PUZZLLM_MODEL"; return; fi
    dir=${KILIX_LLM_MODELS_DIR:-${GPU_TERMINAL_HOME:-$HOME/.local/gpu_terminal}/kilix-llm/models}
    [ -f "$dir/Qwen3.5-0.8B-Q8_0.gguf" ] && printf '%s\n' "$dir/Qwen3.5-0.8B-Q8_0.gguf"
}

omp_bin=$(find_omp)
llama_bin=$(find_llama)
model=$(find_model)

mode=${1:-}
[ $# -gt 0 ] && shift

# One private Kilix owns both panes. The requested agent is the real mode so
# the mounts below stay the ones that agent already uses.
kilix_session=0
if [ "$mode" = kilix ]; then
    kilix_session=1
    mode=${PUZZLLM_AGENT:-agent}
fi

if [ "$mode" = paths ]; then
    printf 'state=%s\nomp=%s\nllama_server=%s\nmodel=%s\nmodel_id=%s\n' \
        "$state" "${omp_bin:-}" "${llama_bin:-}" "${model:-}" "$model_id"
    exit 0
fi

mkdir -p "$state/workspace" "$state/agent/puzzllm" || die "cannot create $state"

# Common confinement. Arrays keep every path one argument.
args=(
    --unshare-all --die-with-parent
    --hostname puzzllm
    --ro-bind /usr /usr
    --proc /proc --dev /dev
    --tmpfs /tmp --tmpfs /home
    --dir /opt/puzzllm
    --symlink "$box_home" /opt/puzzllm/home
    --clearenv
    --setenv HOME /opt/puzzllm/home --setenv USER kilix --setenv LOGNAME kilix
    --setenv PATH /opt/puzzllm/bin:/usr/local/bin:/usr/bin:/bin
    --setenv TERM "${TERM:-xterm-256color}"
    --setenv LANG C.UTF-8 --setenv COLORTERM truecolor
    --setenv TMPDIR /tmp
)
for d in bin lib lib32 lib64 libx32 sbin; do
    if [ -L "/$d" ]; then
        args+=(--symlink "$(readlink "/$d")" "/$d")
    elif [ -d "/$d" ]; then
        args+=(--ro-bind "/$d" "/$d")
    fi
done
for f in passwd group nsswitch.conf ld.so.cache ld.so.conf ld.so.conf.d \
         localtime alternatives ssl ca-certificates terminfo inputrc \
         hosts host.conf manpath.config man_db.conf; do
    [ -e "/etc/$f" ] && args+=(--ro-bind "/etc/$f" "/etc/$f")
done
# ~ is /opt/puzzllm/home, a symlink to the workspace at /kilix. The password
# entry matches, so a lookup that ignores $HOME still lands in the workspace.
printf 'kilix:x:%s:%s:PuzzLLM:/opt/puzzllm/home:/bin/bash\n' "$(id -u)" "$(id -g)" > "$state/passwd"
args+=(--ro-bind "$state/passwd" /etc/passwd)

compute=${PUZZLLM_COMPUTE:-auto}
case "$compute" in auto|cpu|gpu) ;; *) die "PUZZLLM_COMPUTE must be auto, cpu, or gpu" ;; esac
gpu=${PUZZLLM_GPU:-}
if [ "$compute" = cpu ]; then gpu=; fi

case "$mode" in
count-setup|log-setup)
    fixture=count-files
    [ "$mode" != log-setup ] || fixture=follow-log
    exec bwrap "${args[@]}" --new-session \
        --bind "$state/workspace" "$box_home" \
        --ro-bind "$here/../levels/$fixture" /opt/puzzllm/fixture \
        --chdir "$box_home" --remount-ro / -- cp -an /opt/puzzllm/fixture/. .
    ;;
count-check)
    cases=(--dir "/empty folder" --dir "/other files/subfolder")
    # Vary the second populated case to keep a hard-coded total from passing.
    extra=$((4 + RANDOM % 4))
    for ((i = 0; i < extra; i++)); do
        cases+=(--ro-bind /usr/bin/true "/other files/item $i")
    done
    cases+=(--ro-bind /usr/bin/true "/other files/subfolder/ignored.txt")
    exec timeout --kill-after=1s 3s bwrap "${args[@]}" "${cases[@]}" --new-session \
        --ro-bind "$state/workspace" "$box_home" \
        --ro-bind "$here/puzzllm-count-check" /opt/puzzllm/count-check \
        --chdir "$box_home" --remount-ro / -- bash /opt/puzzllm/count-check
    ;;
script-check)
    name=${1:-}
    case "$name" in
        ''|.*|*/*|*' '*) die "script name must be a plain file name" ;;
    esac
    exec timeout --kill-after=1s 3s bwrap "${args[@]}" --new-session \
        --ro-bind "$state/workspace" "$box_home" \
        --ro-bind "$here/puzzllm-script-check" /opt/puzzllm/script-check \
        --chdir "$box_home" --remount-ro / -- bash /opt/puzzllm/script-check "$name"
    ;;
esac

# Only the shell server creates the socket. Every agent, including Grok,
# connects to that same server from its own mount namespace.
case "$mode" in
agent|agent-exec|codex|grok|claude|shell|shell-exec)
    (umask 077 && mkdir -p "$state/tmux") || die "cannot create tmux state"
    tmux_mount=--ro-bind
    [ "$mode" = shell ] && tmux_mount=--bind
    [ "$kilix_session" = 1 ] && tmux_mount=--bind
    args+=("$tmux_mount" "$state/tmux" /opt/puzzllm/tmux
           --setenv TMUX_TMPDIR /opt/puzzllm/tmux)
    ;;
esac

case "$mode" in
agent|agent-exec)
    agent_state=$state/agent
    case "$harness" in
        omp) ;;
        pi)
            agent_state=$state/pi
            (umask 077 && mkdir -p "$agent_state/puzzllm") || die "cannot create Pi state"
            mount_pi
            ;;
        *) die "PUZZLLM_HARNESS must be omp or pi" ;;
    esac
    args+=(--bind "$state/workspace" "$box_home"
           --bind "$agent_state" /opt/puzzllm/agent
           --setenv PI_CODING_AGENT_DIR /opt/puzzllm/agent
           --chdir "$box_home")
    [ "$harness" = omp ] && [ -n "$omp_bin" ] && [ -x "$omp_bin" ] &&
        args+=(--ro-bind "$(readlink -f "$omp_bin")" /opt/puzzllm/bin/omp)
    [ -z "$ollama" ] && [ -n "$llama_bin" ] && [ -x "$llama_bin" ] &&
        args+=(--ro-bind "$(dirname "$(readlink -f "$llama_bin")")" /opt/puzzllm/llama)
    [ -z "$ollama" ] && [ -n "$model" ] && [ -f "$model" ] &&
        args+=(--ro-bind "$(readlink -f "$model")" /opt/puzzllm/model.gguf)
    args+=(--ro-bind "$here/puzzllm-agent-init" /opt/puzzllm/bin/puzzllm-agent-init
           --setenv PUZZLLM_PORT "$port"
           --setenv PUZZLLM_MODEL_ID "$model_id"
           --setenv PUZZLLM_CTX "$ctx"
           --setenv PUZZLLM_THINK "${PUZZLLM_THINK:-0}"
           --setenv PUZZLLM_COMPUTE "$compute"
           --setenv PUZZLLM_GPU "$gpu"
           --setenv PUZZLLM_YOLO "$yolo")
    if [ -z "$ollama" ] && { [ "$compute" = gpu ] || [ -n "$gpu" ]; }; then
        for n in /dev/dri /dev/kfd /dev/nvidiactl /dev/nvidia-uvm /dev/nvidia-modeset \
                 /dev/nvidia[0-9]*; do
            [ -e "$n" ] && args+=(--dev-bind "$n" "$n")
        done
        for n in /sys /etc/vulkan /etc/glvnd; do
            [ -e "$n" ] && args+=(--ro-bind "$n" "$n")
        done
    fi
    ;;
codex)
    codex_bin=${PUZZLLM_CODEX:-$(command -v codex)}
    [ -n "$codex_bin" ] && [ -x "$codex_bin" ] ||
        die "Codex CLI not found (install codex or set PUZZLLM_CODEX)"
    codex_command=$(readlink -f "$codex_bin")
    case "$codex_command" in
        /usr/*) ;;  # Includes npm's wrapper and its dependencies.
        *)
            args+=(--ro-bind "$codex_command" /opt/puzzllm/bin/codex)
            codex_command=/opt/puzzllm/bin/codex
            ;;
    esac
    (umask 077 && mkdir -p "$state/codex") || die "cannot create Codex state"
    # The CLI connects to its hosted provider. Its separate command policy
    # denies network access and masks the Codex credentials from tools.
    args+=(--share-net
           --bind "$state/workspace" "$box_home"
           --bind "$state/codex" /opt/puzzllm/codex-home
           --chdir "$box_home"
           --setenv CODEX_HOME /opt/puzzllm/codex-home
           --setenv PUZZLLM_YOLO "$yolo"
           --ro-bind "$here/puzzllm-codex-init" /opt/puzzllm/bin/puzzllm-codex-init)
    [ ! -r /etc/resolv.conf ] || args+=(--ro-bind /etc/resolv.conf /etc/resolv.conf)
    ;;
grok)
    grok_bin=${PUZZLLM_GROK:-$(command -v grok || true)}
    if [ -z "$grok_bin" ]; then
        for candidate in "$HOME/.grok/bin/grok" "$HOME/.local/bin/grok"; do
            if [ -x "$candidate" ]; then grok_bin=$candidate; break; fi
        done
    fi
    [ -n "$grok_bin" ] && [ -x "$grok_bin" ] ||
        die "Grok Build not found (install the native grok CLI or set PUZZLLM_GROK)"
    (umask 077 && mkdir -p "$state/grok") || die "cannot create Grok state"
    args+=(--share-net
           --bind "$state/workspace" "$box_home"
           --bind "$state/grok" /opt/puzzllm/grok-home
           --chdir "$box_home"
           --setenv GROK_HOME /opt/puzzllm/grok-home
           --setenv PUZZLLM_YOLO "$yolo"
           --ro-bind "$(readlink -f "$grok_bin")" /opt/puzzllm/bin/grok
           --ro-bind "$here/puzzllm-grok-init" /opt/puzzllm/bin/puzzllm-grok-init)
    [ ! -r /etc/resolv.conf ] || args+=(--ro-bind /etc/resolv.conf /etc/resolv.conf)
    ;;
claude)
    claude_bin=${PUZZLLM_CLAUDE:-$(command -v claude || true)}
    if [ -z "$claude_bin" ]; then
        for candidate in "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
            if [ -x "$candidate" ]; then claude_bin=$candidate; break; fi
        done
    fi
    [ -n "$claude_bin" ] && [ -x "$claude_bin" ] ||
        die "Claude Code not found (install claude or set PUZZLLM_CLAUDE)"
    (umask 077 && mkdir -p "$state/claude") || die "cannot create Claude state"
    args+=(--share-net
           --bind "$state/workspace" "$box_home"
           --bind "$state/claude" /opt/puzzllm/claude-home
           --chdir "$box_home"
           --setenv CLAUDE_CONFIG_DIR /opt/puzzllm/claude-home
           --setenv PUZZLLM_YOLO "$yolo"
           --ro-bind "$(readlink -f "$claude_bin")" /opt/puzzllm/bin/claude
           --ro-bind "$here/puzzllm-claude-init" /opt/puzzllm/bin/puzzllm-claude-init)
    [ ! -r /etc/resolv.conf ] || args+=(--ro-bind /etc/resolv.conf /etc/resolv.conf)
    ;;
shell|shell-exec)
    args+=(--bind "$state/workspace" "$box_home"
           --chdir "$box_home"
           --ro-bind "$here/puzzllm-shellrc" /opt/puzzllm/shellrc
           --ro-bind "$here/puzzllm-shell-log" /opt/puzzllm/bin/puzzllm-shell-log
           --ro-bind "$here/puzzllm-shell-init" /opt/puzzllm/bin/puzzllm-shell-init)
    ;;
*)
    die "usage: puzzllm-sandbox agent|codex|grok|claude|shell|agent-exec -- CMD|shell-exec -- CMD|paths"
    ;;
esac

case "$mode" in
agent|agent-exec|codex|grok|claude|shell|shell-exec)
    # This mount must follow the workspace mount.
    (umask 077 && mkdir -p "$state/goals") || die "cannot prepare the goal status socket directory"
    [ ! -L "$state/goals" ] || die "invalid goal status directory"
    args+=(--ro-bind "$here/docs" "$box_home/docs")
    # Earlier live sandboxes published this relative link to the same read-only guide.
    if [[ $(readlink "$state/workspace/check_goal_status.sh") != docs/check_goal_status.sh ]]; then
        args+=(--ro-bind "$here/docs/check_goal_status.sh" "$box_home/check_goal_status.sh")
    fi
    if [ "$kilix_session" != 1 ]; then
        args+=(--ro-bind "$state/goals" /opt/puzzllm/kx/goals)
    fi
    ;;
esac

# Bind the private Kilix over the puzzllm state directory and point every
# storage variable at that bind. The desktop instance is not mounted.
mount_kilix() {
    local env_text kitty kitten broker config src cli_root component candidate needle tools_runtime
    env_text=$("$here/puzzllm-kilix" --shell-env) || die "no private Kilix engine"
    kitty=; kitten=; broker=; config=; src=
    eval "$env_text"
    [ -n "${kitty:-}" ] && [ -n "${kitten:-}" ] && [ -n "${broker:-}" ] &&
        [ -n "${config:-}" ] && [ -n "${src:-}" ] || die "no private Kilix engine"
    needle=$(printf '%s%s' '/.local/gpu_' 'terminal')
    case "$kitty$kitten$broker$config$src" in
        *"$needle"*) die "refusing a desktop Kilix engine" ;;
    esac
    [ -x "$kitty" ] && [ -x "$kitten" ] && [ -x "$broker" ] &&
        [ -f "$config" ] && [ -d "$src" ] || die "Kilix engine is incomplete"
    cli_root=
    local -a cli_candidates=("${PUZZLLM_KILIX_CLI_ROOT:-}" "$(dirname "$(dirname "$config")")"
                             "$(dirname "$(dirname "$(dirname "$(dirname "$kitten")")")")")
    for candidate in "${cli_candidates[@]}"; do
        [ -n "$candidate" ] && [ -x "$candidate/kilix" ] &&
            [ -f "$candidate/config/kilix_facts.py" ] && [ -f "$candidate/config/remote.py" ] || continue
        cli_root=$(readlink -f "$candidate")
        case "$cli_root" in *"$needle"*) cli_root=; continue ;; esac
        break
    done
    [ -n "$cli_root" ] || die "Kilix with Ask is missing (set PUZZLLM_KILIX_CLI_ROOT)"
    mkdir -p "$state/kx/frames" "$state/kx/logs" "$state/kx/b" "$state/kx/g" ||
        die "cannot create Kilix state"
    chmod 700 "$state/kx" "$state/kx/b" "$state/kx/g" || die "cannot lock down Kilix state"
    # Keep the pinned command interpreter outside sandbox-writable storage.
    tools_runtime=$state/runtime/kilix
    (umask 077 && mkdir -p "$tools_runtime/data/desktop-apps") || die "cannot prepare Kilix tools"
    if [ ! -x "$tools_runtime/data/desktop-apps/kilix-needle/kilix-needle" ]; then
        env GPU_TERMINAL_HOME="$tools_runtime" KILIX_STORAGE_HOME="$tools_runtime" \
            KILIX_DATA_HOME="$tools_runtime/data" GIT_TERMINAL_PROMPT=0 \
            flock -n "$tools_runtime/install.lock" timeout 90 python3 -B "$cli_root/config/content_app.py" install kilix-needle \
            </dev/null >"$tools_runtime/ask-install.log" 2>&1 &
    fi
    args+=(--bind "$state/kx" /opt/puzzllm/kx
           --ro-bind "$state/goals" /opt/puzzllm/kx/goals
           --ro-bind "$tools_runtime/data/desktop-apps" /opt/puzzllm/kx/g/k/data/desktop-apps
           --ro-bind "$here/puzzllm-kilix" /opt/puzzllm/bin/puzzllm-kilix
           --ro-bind "$here/puzzllm-cli" /opt/puzzllm/bin/kilix
           --ro-bind "$here/puzzllm-kilix.conf" /opt/puzzllm/bin/puzzllm-kilix.conf
           --ro-bind "$kitten" /opt/puzzllm/bin/kitten
           --ro-bind "$cli_root/kilix" /opt/puzzllm/cli/kilix
           --ro-bind "$cli_root/kilix-settings" /opt/puzzllm/cli/kilix-settings
           --ro-bind "$cli_root/config" /opt/puzzllm/cli/config
           --symlink "$kitty" /opt/puzzllm/cli/engine/bin/kitty
           --ro-bind "$here/puzzllm-cli" /opt/puzzllm/cli/engine/bin/kitten
           --ro-bind "$here/puzzllm_kilix_bridge.py" /opt/puzzllm/bin/puzzllm_kilix_bridge.py
           --ro-bind "$src" "$src"
           --ro-bind "$(dirname "$config")" /opt/puzzllm/kilix-config)
    for component in VERSION kilix-session scripts share third_party/kilix-content third_party/kilix-state; do
        [ ! -e "$cli_root/$component" ] ||
            args+=(--ro-bind "$cli_root/$component" "/opt/puzzllm/cli/$component")
    done
    # The broker loads libkitty-pty-broker.so from $ORIGIN. Binding only the
    # executable leaves that directory empty inside the sandbox, and every
    # pane exits before its control socket exists.
    case "$broker" in
        "$src"|"$src"/*) ;;
        *) args+=(--ro-bind "$(dirname "$broker")" "$(dirname "$broker")") ;;
    esac
    case "$kitty" in
        "$src"/*) ;;
        *) args+=(--ro-bind "$kitty" "$kitty") ;;
    esac
    case "$kitten" in
        "$src"/*) ;;
        *) args+=(--ro-bind "$kitten" "$kitten") ;;
    esac
    [ -d /etc/fonts ] && args+=(--ro-bind /etc/fonts /etc/fonts)
    [ -e /etc/machine-id ] && args+=(--ro-bind /etc/machine-id /etc/machine-id)
    [ -e /var/lib/dbus/machine-id ] &&
        args+=(--ro-bind /var/lib/dbus/machine-id /var/lib/dbus/machine-id)
    if [ "$mode" != shell ]; then
        args+=(--ro-bind "$here/puzzllm-shellrc" /opt/puzzllm/shellrc
               --ro-bind "$here/puzzllm-shell-log" /opt/puzzllm/bin/puzzllm-shell-log
               --ro-bind "$here/puzzllm-shell-init" /opt/puzzllm/bin/puzzllm-shell-init)
    fi
    args+=(--setenv GPU_TERMINAL_HOME /opt/puzzllm/kx/g
           --setenv KILIX_STORAGE_HOME /opt/puzzllm/kx/g/k
           --setenv KILIX_CONFIG_HOME /opt/puzzllm/kx/g/k/config
           --setenv KILIX_STATE_DIRECTORY /opt/puzzllm/kx/g/k/state
           --setenv KILIX_CACHE_HOME /opt/puzzllm/kx/g/k/cache
           --setenv KILIX_SESSION_HOME /opt/puzzllm/kx/g/k/session
           --setenv KILIX_TELEMETRY_RUNTIME /opt/puzzllm/kx/g/k/session/telemetry
           --setenv KILIX_DATA_HOME /opt/puzzllm/kx/g/k/data
           --setenv KILIX_BUILD_DIRECTORY /opt/puzzllm/kx/g/k/build
           --setenv KILIX_PREBUILT_HOME /opt/puzzllm/cli/engine
           --setenv KITTY_CONFIG_DIRECTORY /opt/puzzllm/kx/g/k/config
           --setenv KITTY_PTY_BROKER_RUNTIME /opt/puzzllm/kx/b
           --setenv KITTY_PTY_BROKER_EXECUTABLE "$broker"
           --setenv KITTY_PTY_BROKER_TRANSCRIPT_DIR /opt/puzzllm/kx/logs
           --setenv KITTY_PTY_BROKER_AUTO_RECOVER 0
           --setenv KILIX_PTY_BROKER 1
           --setenv KITTY_LISTEN_ON unix:/opt/puzzllm/kx/listen.sock
           --setenv PUZZLLM_KILIX_LISTEN unix:/opt/puzzllm/kx/listen.sock
           --setenv PUZZLLM_AGENT "$mode"
           --setenv PUZZLLM_PANE_INIT "/opt/puzzllm/bin/puzzllm-${mode}-init"
           --setenv PUZZLLM_KITTY "$kitty"
           --setenv PUZZLLM_KITTEN "$kitten"
           --setenv KILIX_KITTEN /opt/puzzllm/bin/kitten
           --setenv PATH "/opt/puzzllm/bin:$(dirname "$kitten"):/usr/local/bin:/usr/bin:/bin")
}

case "$mode" in
agent)
    [ "$harness" = pi ] || { [ -n "$omp_bin" ] && [ -x "$omp_bin" ]; } ||
        die "omp not found (set PUZZLLM_OMP)"
    model_name="Qwen 3.5 (local)"
    if [ -n "$ollama" ]; then
        model_name="$ollama (Ollama)"
        args+=(--ro-bind @OLLAMA_SOCKET@ /opt/puzzllm/ollama.sock
               --ro-bind "$here/puzzllm-ollama" /opt/puzzllm/bin/puzzllm-ollama
               --ro-bind "$here/puzzllm-ollama-prompt.txt" /opt/puzzllm/ollama-prompt.txt
               --setenv PUZZLLM_OLLAMA_MODEL "$ollama")
    else
        [ -n "$llama_bin" ] && [ -x "$llama_bin" ] ||
            die "llama-server not found (set PUZZLLM_LLAMA_SERVER)"
        [ -n "$model" ] && [ -f "$model" ] ||
            die "Qwen 3.5 weights not found (set PUZZLLM_MODEL); nothing is downloaded"
    fi
    if [ "$harness" = pi ]; then
        python3 - "$agent_state/models.json" "$port" "$model_id" "$model_name" "$ctx" "$reasoning" <<'PY' ||
import json
import sys

path, port, model_id, name, context, reasoning = sys.argv[1:]
provider = {
    "baseUrl": f"http://127.0.0.1:{port}/v1",
    "api": "openai-completions",
    "apiKey": "puzzllm-local",
    "compat": {"supportsStore": False, "supportsDeveloperRole": False,
               "supportsReasoningEffort": False, "maxTokensField": "max_tokens"},
    "models": [{"id": model_id, "name": name, "reasoning": reasoning == "true",
                "input": ["text"], "contextWindow": int(context), "maxTokens": 4096}],
}
with open(path, "w", encoding="utf-8") as config:
    json.dump({"providers": {"puzzllm-local": provider}}, config, indent=2)
PY
            die "cannot write Pi provider configuration"
    else
    # omp's provider config lives in the sandbox's own agent folder, never
    # in the user's ~/.omp: one local provider, on the sandbox's loopback.
    cat > "$state/agent/models.yml" <<EOF
# Written by puzzllm-sandbox on every start. One provider on private loopback.
providers:
  puzzllm-local:
    baseUrl: http://127.0.0.1:$port/v1
    api: openai-completions
    apiKey: puzzllm-local
    models:
      - id: "$model_id"
        name: "$model_name"
        reasoning: $reasoning
        input: [text]
        contextWindow: $ctx
        maxTokens: 4096
EOF
    # A fresh omp profile opens a setup wizard that offers cloud sign-ins;
    # mark setup done (omp's own setupVersion key) so it starts at its prompt.
    cfg=$state/agent/config.yml
    if ! grep -q '^setupVersion:' "$cfg" 2>/dev/null; then
        printf 'setupVersion: 2\n' >> "$cfg"
    fi
    fi
    if [ "$kilix_session" = 1 ]; then
        mount_kilix
        if [ -n "$ollama" ]; then
            exec "$here/puzzllm-ollama" host "$state" "$ollama" \
                bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-kilix --inside "$@"
        fi
        exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-kilix --inside "$@"
    fi
    if [ -n "$ollama" ]; then
        exec "$here/puzzllm-ollama" host "$state" "$ollama" \
            bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-agent-init "$@"
    fi
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-agent-init "$@"
    ;;
codex)
    if [ "$kilix_session" = 1 ]; then
        args+=(--setenv PUZZLLM_CODEX_BIN "$codex_command")
        mount_kilix
        exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-kilix --inside "$@"
    fi
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-codex-init "$codex_command" "$@"
    ;;
grok)
    if [ "$kilix_session" = 1 ]; then
        mount_kilix
        exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-kilix --inside "$@"
    fi
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-grok-init "$@"
    ;;
claude)
    if [ "$kilix_session" = 1 ]; then
        mount_kilix
        exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-kilix --inside "$@"
    fi
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-claude-init "$@"
    ;;
shell)
    exec bwrap "${args[@]}" --remount-ro / -- /opt/puzzllm/bin/puzzllm-shell-init
    ;;
agent-exec|shell-exec)
    [ "${1:-}" = -- ] && shift
    [ $# -gt 0 ] || die "$mode needs a command"
    exec bwrap "${args[@]}" --remount-ro / -- "$@"
    ;;
esac
